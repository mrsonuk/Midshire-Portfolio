# Public demo defaults for Docker running on 64bit Amazon Linux 2023.
# MIDSHIRE_SESSION_SECRET and MIDSHIRE_DATABASE_URL MUST be configured through
# Elastic Beanstalk runtime environment variables sourced from Secrets Manager.
# Startup deliberately fails closed if either secret is missing.
option_settings:
  aws:elasticbeanstalk:application:environment:
    PORT: "8000"
    MIDSHIRE_PUBLIC_MODE: "1"
    MIDSHIRE_WORKERS: "1"
    MIDSHIRE_MAX_RUNNING_JOBS: "1"
    MIDSHIRE_MAX_QUEUED_JOBS: "3"
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: "/healthz"
