# AWS Elastic Beanstalk application environment variables (examples only).
# Never put real passwords or session secrets in this file or GitHub.
MIDSHIRE_PUBLIC_MODE=1
MIDSHIRE_WORKERS=1
MIDSHIRE_MAX_RUNNING_JOBS=1
MIDSHIRE_MAX_QUEUED_JOBS=3
MIDSHIRE_SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MIDSHIRE_DATABASE_URL=postgresql+psycopg://USER:URL_ENCODED_PASSWORD@PRIVATE_RDS_ENDPOINT:5432/midshire?sslmode=require
