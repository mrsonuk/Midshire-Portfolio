{
    "name": "Type 3 Urgent Treatment Centre (UTC)",
    "description": "A GP-led urgent treatment centre for minor illness and injury - no resus or majors, limited imaging, very few admissions (sicker patients are redirected to a Type 1 ED). UTCs treat >95% of people within 4 hours, so this is a useful contrast to the major ED.",
    "sim_duration_minutes": 10080,
    "warmup_minutes": 1440,
    "target_minutes": 240,
    "arrivals": {
        "hourly_profile": [2, 1, 1, 1, 1, 1, 2, 4, 8, 12, 14, 15, 14, 13, 13, 13, 13, 12, 10, 8, 6, 5, 3, 2],
        "acuity_mix": {"Acuity 3": 8, "Acuity 4": 62, "Acuity 5": 30}
    },
    "resources": {
        "receptionist": 2,
        "triage_nurse": 2,
        "utc_room": 12,
        "enp": 6,
        "gp": 3,
        "xray_room": 1
    },
    "nodes": [
        {"id": "arrival", "type": "source", "label": "Arrival", "routes": [["registration", 1.0]]},
        {
            "id": "registration", "type": "process", "label": "Reception",
            "resource": "receptionist",
            "service": {"dist": "lognormal", "mean": 2, "stdev": 1},
            "routes": [["triage", 1.0]]
        },
        {
            "id": "triage", "type": "process", "label": "Triage / streaming",
            "resource": "triage_nurse",
            "service": {"dist": "lognormal", "mean": 4, "stdev": 2},
            "routes_by_class": {
                "Acuity 3": [["gp_assessment", 1.0]],
                "Acuity 4": [["enp_assessment", 0.7], ["gp_assessment", 0.3]],
                "Acuity 5": [["enp_assessment", 1.0]]
            }
        },
        {
            "id": "enp_assessment", "type": "process", "label": "ENP assessment",
            "acquire": ["utc_room"], "resource": "enp",
            "service": {"dist": "lognormal", "mean": 22, "stdev": 10},
            "routes": [["imaging_decision", 1.0]]
        },
        {
            "id": "gp_assessment", "type": "process", "label": "GP assessment",
            "acquire": ["utc_room"], "resource": "gp",
            "service": {"dist": "lognormal", "mean": 18, "stdev": 8},
            "routes": [["imaging_decision", 1.0]]
        },
        {
            "id": "imaging_decision", "type": "process", "label": "Imaging decision",
            "service": {"dist": "constant", "value": 0},
            "routes_by_class": {
                "Acuity 3": [["xray", 0.25], ["outcome", 0.75]],
                "Acuity 4": [["xray", 0.18], ["outcome", 0.82]],
                "Acuity 5": [["xray", 0.05], ["outcome", 0.95]]
            }
        },
        {
            "id": "xray", "type": "process", "label": "X-ray",
            "resource": "xray_room",
            "service": {"dist": "lognormal", "mean": 22, "stdev": 8},
            "routes": [["outcome", 1.0]]
        },
        {
            "id": "outcome", "type": "process", "label": "Treat & decide",
            "release": ["utc_room"],
            "service": {"dist": "lognormal", "mean": 18, "stdev": 10},
            "routes_by_class": {
                "Acuity 3": [["refer_ed", 0.12], ["discharge", 0.88]],
                "Acuity 4": [["refer_ed", 0.04], ["discharge", 0.96]],
                "Acuity 5": [["refer_ed", 0.01], ["discharge", 0.99]]
            }
        },
        {
            "id": "refer_ed", "type": "process", "label": "Refer to ED",
            "service": {"dist": "lognormal", "mean": 15, "stdev": 8},
            "routes": [["referred", 1.0]]
        },
        {
            "id": "discharge", "type": "process", "label": "Discharge",
            "service": {"dist": "lognormal", "mean": 8, "stdev": 5},
            "routes": [["discharged", 1.0]]
        },
        {"id": "referred", "type": "sink", "label": "Referred to ED"},
        {"id": "discharged", "type": "sink", "label": "Discharged"}
    ]
}
