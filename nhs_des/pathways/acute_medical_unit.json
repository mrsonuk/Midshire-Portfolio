{
    "name": "Acute Medical Unit (AMU)",
    "description": "A medical assessment pathway taking GP and ED referrals: triage, nurse clerking, junior-doctor clerking, consultant post-take review, then admit to a ward or discharge. Demonstrates that the same engine drives a completely different NHS flow with no code changes.",
    "sim_duration_minutes": 10080,
    "warmup_minutes": 1440,
    "target_minutes": 240,
    "arrivals": {
        "hourly_profile": [2, 1, 1, 1, 1, 1, 2, 3, 5, 8, 10, 11, 10, 9, 9, 9, 9, 8, 7, 6, 5, 4, 3, 2],
        "acuity_mix": {
            "GP referral": 55,
            "ED referral": 35,
            "Direct access": 10
        }
    },
    "resources": {
        "amu_bed": 24,
        "clerking_nurse": 4,
        "junior_doctor": 6,
        "consultant": 3,
        "pharmacist": 3,
        "ward_bed": 26
    },
    "nodes": [
        {"id": "arrival", "type": "source", "label": "Referral arrives", "routes": [["allocate_bed", 1.0]]},
        {
            "id": "allocate_bed", "type": "process", "label": "Allocate AMU bed",
            "acquire": ["amu_bed"],
            "service": {"dist": "constant", "value": 0},
            "routes": [["nurse_clerking", 1.0]]
        },
        {
            "id": "nurse_clerking", "type": "process", "label": "Nurse clerking & obs",
            "resource": "clerking_nurse",
            "service": {"dist": "lognormal", "mean": 30, "stdev": 12},
            "routes": [["doctor_clerking", 1.0]]
        },
        {
            "id": "doctor_clerking", "type": "process", "label": "Junior doctor clerking",
            "resource": "junior_doctor",
            "service": {"dist": "lognormal", "mean": 55, "stdev": 25},
            "routes": [["consultant_review", 1.0]]
        },
        {
            "id": "consultant_review", "type": "process", "label": "Consultant post-take review",
            "resource": "consultant",
            "service": {"dist": "lognormal", "mean": 25, "stdev": 12},
            "routes_by_class": {
                "GP referral": [["pharmacy", 0.6], ["outcome", 0.4]],
                "ED referral": [["pharmacy", 0.7], ["outcome", 0.3]],
                "Direct access": [["pharmacy", 0.5], ["outcome", 0.5]]
            }
        },
        {
            "id": "pharmacy", "type": "process", "label": "Pharmacy / TTOs",
            "resource": "pharmacist",
            "service": {"dist": "lognormal", "mean": 35, "stdev": 15},
            "routes": [["outcome", 1.0]]
        },
        {
            "id": "outcome", "type": "process", "label": "Disposition decision",
            "service": {"dist": "lognormal", "mean": 15, "stdev": 8},
            "routes_by_class": {
                "GP referral": [["await_ward", 0.55], ["discharge", 0.45]],
                "ED referral": [["await_ward", 0.7], ["discharge", 0.3]],
                "Direct access": [["await_ward", 0.5], ["discharge", 0.5]]
            }
        },
        {
            "id": "await_ward", "type": "process", "label": "Wait for ward bed",
            "acquire": ["ward_bed"],
            "release": ["amu_bed"],
            "stops_clock": true,
            "service": {"dist": "lognormal", "mean": 20, "stdev": 10},
            "routes": [["ward_stay", 1.0]]
        },
        {
            "id": "ward_stay", "type": "process", "label": "Transfer to ward",
            "service": {"dist": "lognormal", "mean": 360, "stdev": 180},
            "routes": [["admitted", 1.0]]
        },
        {
            "id": "discharge", "type": "process", "label": "Discharge home",
            "release": ["amu_bed"],
            "service": {"dist": "lognormal", "mean": 15, "stdev": 10},
            "routes": [["discharged", 1.0]]
        },
        {"id": "admitted", "type": "sink", "label": "Admitted to ward"},
        {"id": "discharged", "type": "sink", "label": "Discharged"}
    ]
}
