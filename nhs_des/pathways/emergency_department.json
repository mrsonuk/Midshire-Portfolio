        {
            "id": "await_bed",
            "type": "process",
            "label": "Wait for inpatient bed",
            "resource": "inpatient_bed",
            "service": {"dist": "lognormal", "mean": 320, "stdev": 160},
            "routes": [["admitted", 1.0]]
        },
        {
            "id": "discharge",
            "type": "process",
            "label": "Discharge",
            "service": {"dist": "lognormal", "mean": 12, "stdev": 8},
            "routes": [["discharged", 1.0]]
        },
        {"id": "admitted", "type": "sink", "label": "Admitted"},
        {"id": "admitted_mh", "type": "sink", "label": "Admitted (MH)"},
        {"id": "discharged", "type": "sink", "label": "Discharged"}
