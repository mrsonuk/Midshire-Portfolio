            "type": "process",
            "label": "Imaging decision",
            "service": {"dist": "constant", "value": 0},
            "routes_by_class": {
                "Acuity 1": [["ct", 0.22], ["xray", 0.26], ["outcome", 0.52]],
                "Acuity 2": [["ct", 0.18], ["xray", 0.33], ["outcome", 0.49]],
                "Acuity 3": [["ct", 0.13], ["xray", 0.22], ["outcome", 0.65]],
                "Acuity 4": [["ct", 0.05], ["xray", 0.10], ["outcome", 0.85]],
                "Acuity 5": [["ct", 0.02], ["xray", 0.04], ["outcome", 0.94]]
