                "Acuity 2": [["resus", 0.3], ["majors", 0.7]],
                "Acuity 3": [["majors", 1.0]],
                "Acuity 4": [["sdec", 0.35], ["minors", 0.65]],
                "Acuity 5": [["minors", 1.0]]
