            "service": {"dist": "lognormal", "mean": 20, "stdev": 10},
            "routes_by_attribute": {
                "mental_health": [["mh_assessment", 1.0]]
            },
            "routes_by_class": {
                "Acuity 1": [["await_bed", 0.585], ["discharge", 0.415]],
                "Acuity 2": [["await_bed", 0.489], ["discharge", 0.511]],
                "Acuity 3": [["await_bed", 0.264], ["discharge", 0.736]],
                "Acuity 4": [["await_bed", 0.103], ["discharge", 0.897]],
                "Acuity 5": [["await_bed", 0.036], ["discharge", 0.964]]
            }
        },
        {
            "id": "mh_assessment",
            "type": "process",
            "label": "Mental health assessment",
            "acquire": ["mh_assessment_room"],
            "release": ["mh_assessment_room"],
