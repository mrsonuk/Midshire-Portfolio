        {
            "id": "mh_await_bed",
            "type": "process",
            "label": "Wait for MH bed",
            "acquire": ["mh_inpatient_bed"],
            "service": {"dist": "lognormal", "mean": 600, "stdev": 360},
            "routes": [["admitted_mh", 1.0]]
