        },
        {
            "id": "resus",
            "type": "process",
            "label": "Resus",
            "acquire": ["resus_bay"],
            "resource": "ed_doctor",
            "service_by_class": {
                "Acuity 1": {"dist": "lognormal", "mean": 125, "stdev": 45},
                "Acuity 2": {"dist": "lognormal", "mean": 105, "stdev": 40}
            },
            "service": {"dist": "lognormal", "mean": 110, "stdev": 40},
            "routes": [["imaging_decision", 1.0]]
        },
        {
            "id": "majors",
            "type": "process",
            "label": "Majors",
            "acquire": ["majors_bed"],
