        {
            "id": "minors",
            "type": "process",
            "label": "Minors",
            "acquire": ["minors_bay"],
            "resource": "ed_doctor",
            "service_by_class": {
                "Acuity 4": {"dist": "lognormal", "mean": 25, "stdev": 12},
                "Acuity 5": {"dist": "lognormal", "mean": 15, "stdev": 8}
